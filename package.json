{
  "name": "work-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply work-tracker --local",
    "db:migrate": "wrangler d1 migrations apply work-tracker --remote",
    "deploy": "wrangler deploy",
    "cf:ensure": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/ensure-cloudflare.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
